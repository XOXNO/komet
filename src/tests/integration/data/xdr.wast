setExitCode(1)

;; Expected bytes and errors independently checked against soroban-env-host 28.0.2.
uploadWasm(b"xdr-code", (module
  (import "b" "_" (func $serialize (param i64) (result i64)))
  (import "b" "0" (func $deserialize (param i64) (result i64)))
  (func (export "roundtrip") (param i64) (result i64)
    (call $serialize (call $deserialize (local.get 0))))
  (func (export "serialize") (param i64) (result i64)
    (call $serialize (local.get 0)))
  (func (export "serialize_bad_minor") (result i64)
    (call $serialize (i64.const 260)))
  (func (export "deserialize_forged") (param i64) (result i64)
    (call $deserialize (i64.xor (local.get 0) (i64.const 1))))
  (func (export "deserialize_bad_minor") (param i64) (result i64)
    (call $deserialize (i64.or (local.get 0) (i64.const 256))))
))
setAccount(Account(b"xdr-owner"), 1000000)
deployContract(Account(b"xdr-owner"), Contract(b"xdr-contract"), b"xdr-code")

;; empty
callTx(Account(b"xdr-caller"), Contract(b"xdr-contract"), "roundtrip",
  ListItem(ScBytes(b"")),
  Error(ErrContext, ExceededLimit)
)

