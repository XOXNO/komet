setExitCode(1)

uploadWasm(b"integer-abi",
(module
  (import "i" "9" (func $ufrom (param i64 i64 i64 i64) (result i64)))
  (import "i" "g" (func $ifrom (param i64 i64 i64 i64) (result i64)))
  (import "i" "c" (func $u_hi_hi (param i64) (result i64)))
  (import "i" "d" (func $u_hi_lo (param i64) (result i64)))
