  (import "i" "l" (func $i_lo_hi (param i64) (result i64)))
  (import "i" "m" (func $i_lo_lo (param i64) (result i64)))
  (func (export "reject_u_hi_hi") (result i64) (call $u_hi_hi (i64.const 12)))
  (func (export "reject_u_hi_lo") (result i64) (call $u_hi_lo (i64.const 268)))
  (func (export "reject_u_lo_hi") (result i64) (call $u_lo_hi (i64.const 12)))
  (func (export "reject_u_lo_lo") (result i64) (call $u_lo_lo (i64.const 268)))
  (func (export "reject_i_hi_hi") (result i64) (call $i_hi_hi (i64.const 13)))
  (func (export "reject_i_hi_lo") (result i64) (call $i_hi_lo (i64.const 269)))
  (func (export "reject_i_lo_hi") (result i64) (call $i_lo_hi (i64.const -243)))
  (func (export "reject_i_lo_lo") (result i64) (call $i_lo_lo (i64.const 13)))
  (func (export "u_object_tag") (result i64)
    (i64.or (i64.const 4)
      (i64.shl (i64.and (i64.const 255)
        (call $ufrom (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 1)))
        (i64.const 32))))
  (func (export "i_object_tag") (result i64)
    (i64.or (i64.const 4)
      (i64.shl (i64.and (i64.const 255)
        (call $ifrom (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 1)))
        (i64.const 32))))
  (func (export "i_minor") (result i64)
    (call $i_hi_hi (i64.or (i64.const 256)
      (call $ifrom (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 1)))))
  (func (export "u_minor") (result i64)
    (call $u_hi_hi (i64.or (i64.const 256)
      (call $ufrom (i64.const 0) (i64.const 0) (i64.const 0) (i64.const 1)))))
))

setAccount(Account(b"test-account"), 9876543210)
deployContract(Account(b"test-account"), Contract(b"test-sc"), b"integer-abi")

callTx(Account(b"test-caller"), Contract(b"test-sc"), "reject_u_hi_hi", .List, Error(ErrValue, InvalidInput))
